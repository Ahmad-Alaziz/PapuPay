// Merchant dashboard data: who can sign in, which organisation they belong to,
// the venues that organisation runs, and an audit trail of changes. Settings,
// loyalty programmes and published releases are added in later migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum VenueStatus {
  DRAFT
  LIVE
}

enum Locale {
  pl
  en
}

enum WifiSecurity {
  WPA
  WEP
  NOPASS
}

enum AssetKind {
  LOGO
  LOGO_WHITE
  BANNER
  MENU_PDF
}

/// Languages the guest apps show menus in.
enum MenuLanguage {
  pl
  en
  ru
}

model Organization {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships Membership[]
  venues      Venue[]
  invitations Invitation[]
  auditLogs   AuditLog[]

  @@map("organizations")
}

model User {
  id              String          @id @default(uuid()) @db.Uuid
  /// Stored lower-cased and trimmed so sign-in matches regardless of how it was typed.
  email           String          @unique
  name            String?
  locale          Locale          @default(pl)
  /// PapuPay team members who create organisations and send the first invite.
  isPlatformAdmin Boolean         @default(false) @map("is_platform_admin")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships     Membership[]
  sessions        Session[]
  settingsEdits   VenueSettings[]
  uploads         Asset[]
  loginTokens     LoginToken[]
  invitationsSent Invitation[]    @relation("InvitedBy")
  auditLogs       AuditLog[]

  @@map("users")
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  role           Role
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model Venue {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  /// Public identifier in /v/<slug> and /go/<slug>/…, printed on NFC stickers and QR codes.
  /// Locked once the venue is live.
  slug           String         @unique
  name           String
  /// IANA time zone used for daily stamp limits and expiry dates.
  timezone       String         @default("Europe/Warsaw")
  status         VenueStatus    @default(DRAFT)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  settings       VenueSettings?
  assets         Asset[]

  @@index([organizationId])
  @@map("venues")
}

/// An emailed invitation to join an organisation. The link carries a random
/// token; only its SHA-256 hash is stored.
model Invitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  email          String
  role           Role
  /// Language of the invitation email and the accept page.
  locale         Locale       @default(pl)
  tokenHash      String       @unique @map("token_hash")
  invitedById    String?      @map("invited_by_id") @db.Uuid
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime?    @map("accepted_at") @db.Timestamptz(3)
  revokedAt      DateTime?    @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User?        @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

/// A single-use sign-in link. Only the hash of the emailed token is stored.
model LoginToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("login_tokens")
}

/// A signed-in browser. The cookie holds a random token; only its hash is stored.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  userAgent String?  @map("user_agent")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Who changed what, for every dashboard change and sign-in.
model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  actorId        String?       @map("actor_id") @db.Uuid
  /// Dotted verb such as "invitation.created" or "member.role_changed".
  action         String
  targetType     String?       @map("target_type")
  targetId       String?       @map("target_id")
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

/// The venue's draft configuration, one row per venue. Guests only see what's
/// published, so editing here changes nothing in the App Clip until Publish.
model VenueSettings {
  venueId               String        @id @map("venue_id") @db.Uuid
  address               String?
  mapUrl                String?       @map("map_url")
  logoAssetId           String?       @map("logo_asset_id") @db.Uuid
  logoWhiteAssetId      String?       @map("logo_white_asset_id") @db.Uuid
  bannerAssetId         String?       @map("banner_asset_id") @db.Uuid
  /// One of the guest apps' theme presets: sweeto, berry or forest.
  themePreset           String        @default("sweeto") @map("theme_preset")
  /// Overrides the preset's font: bricolage, dm-sans, manrope, serif or system.
  font                  String?
  wifiSsid              String?       @map("wifi_ssid")
  wifiSecurity          WifiSecurity? @map("wifi_security")
  /// AES-256-GCM, see src/merchant/secrets.ts. Never sent to the browser except in the test QR.
  wifiPasswordEncrypted String?       @map("wifi_password_encrypted")
  wifiHidden            Boolean       @default(false) @map("wifi_hidden")
  reviewUrl             String?       @map("review_url")
  menuPdfPlAssetId      String?       @map("menu_pdf_pl_asset_id") @db.Uuid
  menuPdfEnAssetId      String?       @map("menu_pdf_en_asset_id") @db.Uuid
  menuPdfRuAssetId      String?       @map("menu_pdf_ru_asset_id") @db.Uuid
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById           String?       @map("updated_by_id") @db.Uuid
  venue                 Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  updatedBy             User?         @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("venue_settings")
}

/// An uploaded file in Supabase Storage. Replaced files are kept, because
/// published releases may still point at them.
model Asset {
  id          String        @id @default(uuid()) @db.Uuid
  venueId     String        @map("venue_id") @db.Uuid
  kind        AssetKind
  /// Path inside the storage bucket, e.g. venues/<venue id>/banner/<uuid>.webp
  storagePath String        @unique @map("storage_path")
  contentType String        @map("content_type")
  byteSize    Int           @map("byte_size")
  /// Measured in the browser before upload; a hint for layout, not trusted.
  width       Int?
  height      Int?
  language    MenuLanguage?
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?       @map("created_by_id") @db.Uuid
  venue       Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([venueId, kind])
  @@map("assets")
}
