{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "node scripts/prepare-vercel-assets.mjs && npm run build",
  "outputDirectory": ".next",
  "regions": [
    "fra1"
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.papupay.com"
        }
      ],
      "destination": "https://papupay.com/:path*",
      "permanent": true
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':!apps/ios' ':!packages/brand' ':!.github' ':!docs' && git diff --quiet HEAD^ HEAD -- ':(glob)apps/ios/Resources/Assets.xcassets/GoogleWalletBadge*.imageset/**'"
}
