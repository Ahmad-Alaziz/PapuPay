{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.papupay.com"
        }
      ],
      "destination": "https://papupay.com/:path*",
      "permanent": true
    }
  ],
  "ignoreCommand": "case \"$(git log -1 --format=%B)\" in *\"[testflight-only]\"*) exit 0;; *) exit 1;; esac"
}
