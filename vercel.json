{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/en",
      "destination": "/en.html"
    },
    {
      "source": "/pl",
      "destination": "/pl.html"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/go/:path*",
      "destination": "/clip.html"
    },
    {
      "source": "/clip",
      "destination": "/clip.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.papupay.com"
        }
      ],
      "destination": "https://papupay.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "NEXT_LOCALE",
          "value": "pl"
        }
      ],
      "destination": "/pl",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "NEXT_LOCALE",
          "value": "en"
        }
      ],
      "destination": "/en",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "pl(?:[-,;].*)?"
        }
      ],
      "destination": "/pl",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/en",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/:lang(en|pl)/opengraph-image",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "ignoreCommand": "case \"$(git log -1 --format=%B)\" in *\"[testflight-only]\"*) exit 0;; *) exit 1;; esac"
}
