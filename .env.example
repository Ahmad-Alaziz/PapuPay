# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# Mailjet API credentials (https://app.mailjet.com/account/apikeys)
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# Sender address. Must be a validated sender or domain in your Mailjet account.
MAILJET_SENDER_EMAIL=hello@example.com

# Optional sender for dashboard sign-in links and invitations (e.g. no-reply@papupay.com).
# Falls back to MAILJET_SENDER_EMAIL. Without Mailjet keys, development prints the links
# to the server console instead of sending them.
MAILJET_ACCOUNT_SENDER_EMAIL=

# Who receives contact form messages. Comma-separated. Server-side only.
CONTACT_RECIPIENTS=team@example.com,sales@example.com

# Optional. Public URL used for canonical links, Open Graph, sitemap and robots.
# On Vercel it falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=

# PostgreSQL for the Next.js venue API and Apple Wallet worker.
# Use a pooled connection URL on hosted deployments.
DATABASE_URL=
# Optional direct/admin connection used only to apply schema changes and import SQLite.
PAPUPAY_MIGRATION_DATABASE_URL=

# Optional isolated development demo. Create a separate PostgreSQL database for it.
PAPUPAY_DEMO=0
PAPUPAY_DEMO_DATABASE_URL=

# Set strong values before enabling staff checkout.
PAPUPAY_STAFF_PIN=
PAPUPAY_MANAGER_PIN=

# Merchant dashboard (Prisma). DATABASE_URL above is the app's pooled connection
# (Supabase transaction pooler, port 6543). Prisma Migrate uses the session
# pooler (port 5432) and only manages the `public` schema; the venue API keeps
# its own per-venue schemas in the same database.
DIRECT_URL=

# Supabase Storage for venue logos, banners and menu PDFs.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=venue-assets
